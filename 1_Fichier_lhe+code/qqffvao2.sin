model = SM_CKM

ms = 0
mc = 0
mb = 0
mtau = 0
mmu = 0
me = 0
mH = 12000 GeV
alias qz = d:u:s:c:b
alias Qz = D:U:S:C:B

process qq = e1, E1 => qz, Qz


compile()

?allow_decays = true

?ps_fsr_active = false
?hadronization_active = false
?ps_isr_active = false
#?ps_use_PYTHIA_shower = true

#?ps_PYTHIA_verbose = false

!?openmp_is_active = true
?omega_openmp = true
!openmp_num_threads = 1


sqrts = 380.0

beams = e1, E1



integrate (qq) { iterations = 10: 10000}


n_events = 500
sample_format = lhef
simulate(qq) {}

compile_analysis 
